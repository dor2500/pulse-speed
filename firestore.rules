rules_version = '2';
// Each signed-in user can read and write only their own history.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/results/{result} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'd', 'u', 'p', 'j', 'isp', 'srv', 'net', 'src', 'dlp', 'ulp', 'bbg'])
        && request.resource.data.t is int && request.resource.data.d is number;
    }
  }
}
